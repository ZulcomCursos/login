<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ZULCOM - Técnico</title>

  <!-- Tus CSS -->
  <link rel="stylesheet" href="/css/dashboard/navbar.css" />
  <link rel="stylesheet" href="/css/dashboard/dashboard.css" />
  <link rel="stylesheet" href="/css/tickets/tabla.css" />

  <!-- Iconos (opcional) -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
</head>

<body>
  <div class="dashboard-container">
    <%- include('../partials/navtecnico') %>

      <main class="main-content">
        <header class="content-header">
          <h1>PANEL TÉCNICO</h1>
          <div class="user-actions">
            <div>
              <a href="/auth/change-password">
                <img src="/img/logo-perfil.png" alt="Logo Perfil" class="img-perfil" />
              </a>
            </div>

            <% if (user && user.nombres && user.apellidos) { %>
              <span class="user-name">Técnico: <%= user.nombres %>
                  <%= user.apellidos %></span>
              <% } %>
                <a href="/auth/logout" class="logout-btn"
                  onclick="return confirm('¿Estás seguro de cerrar sesión?')">Cerrar Sesión</a>
          </div>
      </header>

      <!-- 🔽 Filtro avanzado (adaptado a tu CSS). Sin botón Aplicar -->
      <form id="filtroAvanzadoForm" onsubmit="return false;">
        <!-- Estado -->
        <div>
          <label for="statusFilter" class="form-label">Estado:</label>
          <select id="statusFilter" class="form-select">
            <option value="todos">Todos</option>
            <option value="abierto" selected>Abiertos</option>
            <option value="cerrado">Cerrados</option>
          </select>
        </div>

        <!-- Prioridad -->
        <div>
          <label for="priorityFilter" class="form-label">Prioridad:</label>
          <select id="priorityFilter" class="form-select">
            <option value="todas" selected>Todas</option>
            <option value="Alta">Alta</option>
            <option value="Media">Media</option>
            <option value="Baja">Baja</option>
          </select>
        </div>


        <!-- Botón Limpiar (usa tu estilo y resetea al instante) -->
        <div class="col-12 text-end">
          <button type="reset" class="btn btn-secondary"><i class="bi bi-eraser"></i> Limpiar</button>
        </div>
      </form>

      <!-- 🔽 Contenido -->
      <div class="dashboard-content">
        <h2>Listado de Tickets</h2>

        <!-- contenedor responsivo (coincide con tu CSS) -->
        <div class="table-responsive">
          <table class="table">
            <thead>
              <tr>
                <th>Número</th>
                <th>Cliente</th>
                <th>Celular</th>
                <th>Prioridad</th>
                <th>Acción</th>
              </tr>
            </thead>
            <tbody id="tablaTickets">
              <% tickets.forEach(ticket => { 
                   const clienteNombre = ticket.client ? `${ticket.client.nombre} ${ticket.client.apellido}` : '';
                   const telefono = ticket.client?.telefono1 || '';
                   const direccion = ticket.client?.direccion || '';
                   const referencias = ticket.client?.referencias || '';
                   const searchBlob = `${ticket.ticketNumber} ${clienteNombre} ${telefono} ${direccion} ${referencias} ${ticket.issueType} ${ticket.description}`.trim();
              %>
                <tr
                  data-status="<%= ticket.status %>"
                  data-priority="<%= ticket.priority %>"
                  data-search="<%- searchBlob %>">
                  <td><%= ticket.ticketNumber %></td>
                  <td><%= clienteNombre || 'Cliente no asignado' %></td>
                  <td><%= telefono || 'Sin teléfono' %></td>
                  <td>
                    <span class="badge <%= ticket.priority === 'Alta'
                                            ? 'bg-danger'
                                            : ticket.priority === 'Media'
                                              ? 'bg-warning'
                                              : 'bg-success' %>">
                      <%= ticket.priority %>
                    </span>
                  </td>
                  <td>
                    <div class="acciones-container">
                      <% if(ticket.status === 'abierto') { %>
                        <a href="/tecnico/<%= ticket.id %>/resolver" class="btn-accion warning">
                          <i class="bi bi-check2-circle"></i>&nbsp;Aceptar
                        </a>
                      <% } %>
                      <a href="/tecnico/<%= ticket.id %>/ver" class="btn-accion info">
                        <i class="bi bi-eye"></i>&nbsp;Ver
                      </a>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </div>

  <!-- Tu JS -->
  <script src="/js/tickets/tickets.js"></script>
</body>
</html>
