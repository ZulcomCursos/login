<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ZULCOM - Técnico</title>
  <link rel="stylesheet" href="/css/dashboard/navbar.css" />
  <link rel="stylesheet" href="/css/dashboard/dashboard.css" />
  <link rel="stylesheet" href="/css/tecnico/index.css" />
  <!-- Puedes agregar aquí otros estilos necesarios para la tabla -->
</head>

<body>
  <div class="dashboard-container">
    <%- include('../partials/navtecnico') %>

      <main class="main-content">
        <header class="content-header">
          <h1>PANEL TÉCNICO</h1>
          <div class="user-actions">
            <div>
              <a href="/auth/change-password">
                <img src="/img/logo-perfil.png" alt="Logo Perfil" class="img-perfil" />
              </a>
            </div>

            <% if (user && user.nombres && user.apellidos) { %>
              <span class="user-name">Técnico: <%= user.nombres %>
                  <%= user.apellidos %></span>
              <% } %>
                <a href="/auth/logout" class="logout-btn"
                  onclick="return confirm('¿Estás seguro de cerrar sesión?')">Cerrar Sesión</a>
          </div>
        </header>
        <h2>Listado de Tickets</h2>

        <div class="dashboard-content">
          <table class="table table-bordered table-hover">
            <thead>
              <tr>
                <th>Número</th>
                <th>Cliente</th>
                <th>Cédula</th>
                <th>IP</th>
                <th>Celular</th>
                <th>Dirección</th>
                <th>Referencia</th>
                <th>Técnico</th>
                <th>Tipo de Problema</th>
                <th>Descripción</th>
                <th>Estado</th>
                <th>Hora Visita</th>
                <th>Acción</th>
              </tr>
            </thead>
            <tbody>
              <% tickets.forEach(ticket=> { %>
                <tr>
                  <td>
                    <%= ticket.ticketNumber %>
                  </td>
                  <td>
                    <% if (ticket.client) { %>
                      <div>
                          <%= ticket.client.apellido %>
                        </div>
                      <div>
                        <%= ticket.client.nombre %>
                      </div>
                      <% } else { %>
                        Cliente no asignado
                        <% } %>
                  </td>
                  <td>
                    <%= ticket.client?.cedula || 'Sin cédula' %>
                  </td>
                  <td>
                    <%= ticket.client?.ip || 'Sin IP' %>
                  </td>
                  <td>
                    <%= ticket.client?.telefono1 || 'Sin teléfono' %>
                  </td>
                  <td>
                    <%= ticket.client?.direccion || 'Sin dirección' %>
                  </td>
                  <td>
                    <%= ticket.client?.referencias || 'Sin referencia' %>
                  </td>
                  <td>
                    <% if (ticket.tecnico) { %>
                      <div>
                          <%= ticket.tecnico.apellidos %>
                        </div>
                      <div>
                        <%= ticket.tecnico.nombres %>
                      </div>
                      <% } else { %>
                        Sin técnico asignado
                        <% } %>
                  </td>
                  <td>
                    <%= ticket.issueType %>
                  </td>
                  <td>
                    <%= ticket.description %>
                  </td>
                  <td>
                    <%= ticket.status %>
                  </td>
                  <td>
                    <%= ticket.horaVisita || '—' %>
                  </td>
                  <td>
                    <% if (ticket.status==='abierto' ) { %>
                      <!-- Botón para aceptar -->
                      <a href="/tecnico/<%= ticket.id %>/resolver" class="btn btn-success">Aceptar</a>

                      <!-- Botón para generar PDF (si no existe aún) -->

                      <% } %>

                        <a href="/tecnico/<%= ticket.id %>/pdf" class="btn btn-success">
                          Generar PDF
                        </a>
                  </td>


                </tr>
                <% }) %>
            </tbody>
          </table>
        </div>

      </main>
  </div>
</body>

</html>