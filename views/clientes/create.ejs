<!DOCTYPE html> 
<html lang="es"> 
<head> 
  <meta charset="UTF-8"> 
  <meta name="viewport" content="width=device-width, initial-scale=1.0"> 
  <title>ZULCOM - Administrador</title> 
  <link rel="stylesheet" href="/css/dashboard/navbar.css" /> 
  <link rel="stylesheet" href="/css/dashboard/dashboard.css" /> 
  <link rel="stylesheet" href="/css/create.css" /> 
</head> 
<body> 
  <div class="dashboard-container"> 
    <%- include('../partials/navadministrador') %> 
    <main class="main-content"> 
      <header class="content-header"> 
        <h1>PANEL ADMINISTRATIVO</h1> 
        <div class="user-actions"> 
          <div> 
            <a href="/auth/change-password"><img src="/img/logo-perfil.png" alt="Logo Perfil" class="img-perfil"></a> 
          </div> 
          <% if (user && user.nombres && user.apellidos) { %> 
            <span class="user-name">Administrador: <%= user.nombres %> <%= user.apellidos %> </span> 
          <% } %> 
          <a href="/auth/logout" class="logout-btn" onclick="return confirm('¿Estás seguro de cerrar sesión?')">Cerrar Sesión</a> 
        </div> 
      </header> 
      <!-- Contenido específico del dashboard administrativo --> 
      <div class="dashboard-content"> 
        <h2>Nuevo Cliente</h2> 
        <form action="/clientes" method="POST"> 
          <div class="form-group"> 
            <label for="estado">Estado:</label> 
            <select id="estado" name="estado" required> 
              <option value="Activo" selected>Activo</option> 
              <option value="Inactivo">Inactivo</option> 
            </select> 
          </div> 
          <div class="form-group"> 
            <label for="ip">IP:</label> 
            <input type="text" id="ip" name="ip" required pattern="^(\d{1,3}\.){3}\d{1,3}$" title="Formato de IP inválido. Ej: 192.168.0.1"> 
          </div> 
          <div class="form-group"> 
            <label for="cedula">Cédula:</label> 
            <input type="text" id="cedula" name="cedula" required pattern="[0-9]{10}" maxlength="10" title="Ingrese 10 dígitos numéricos"> 
          </div> 
          <div class="form-group"> 
            <label for="apellido">Apellidos:</label> 
            <input type="text" id="apellido" name="apellido" required pattern="[A-Za-zÁÉÍÓÚÑáéíóúñ ]+" title="Solo letras y espacios"> 
          </div> 
          <div class="form-group"> 
            <label for="nombre">Nombres:</label> 
            <input type="text" id="nombre" name="nombre" required pattern="[A-Za-zÁÉÍÓÚÑáéíóúñ ]+" title="Solo letras y espacios"> 
          </div> 
          <div class="form-group"> 
            <label for="direccion">Dirección:</label> 
            <textarea id="direccion" name="direccion" required></textarea> 
          </div> 
          <div class="form-group"> 
            <label for="coordenadas">Coordenadas:</label> 
            <input type="text" id="coordenadas" name="coordenadas" pattern="^-?\d+(\.\d+)?,\s*-?\d+(\.\d+)?$" title="Formato válido: -0.1234, -78.5678"> 
          </div> 
          <div class="form-group"> 
            <label for="referencias">Referencias:</label> 
            <textarea id="referencias" name="referencias"></textarea> 
          </div> 
          <div class="form-group"> 
            <label for="telefono1">Teléfono Principal:</label> 
            <input type="text" id="telefono1" name="telefono1" required pattern="[0-9]{10}" maxlength="10" title="Ingrese 10 dígitos numéricos"> 
          </div> 
          <div class="form-group"> 
            <label for="telefono2">Teléfono Secundario:</label> 
            <input type="text" id="telefono2" name="telefono2" pattern="[0-9]{10}" maxlength="10" title="Ingrese 10 dígitos numéricos"> 
          </div> 
          <div class="form-group"> 
            <label for="correo">Correo:</label> 
            <input type="email" id="correo" name="correo" required> 
          </div> 
          <div class="form-group"> 
            <label for="id_plan">Plan:</label> 
            <select id="id_plan" name="id_plan" required> 
              <% planes.forEach(plan => { %> 
                <option value="<%= plan.id_plan %>"> 
                  <%= plan.nombre_plan %> - <%= plan.megas %> Mbps - $<%= plan.costo %> 
                </option> 
              <% }) %> 
            </select> 
          </div> 
          <div class="form-group"> 
            <label>Discapacidad:</label> 
            <div> 
              <label for="discapacidad_si">Sí</label> 
              <input type="radio" id="discapacidad_si" name="discapacidad" value="si" required> 
              <label for="discapacidad_no">No</label> 
              <input type="radio" id="discapacidad_no" name="discapacidad" value="no"> 
            </div> 
          </div> 
          <div class="form-group"> 
            <label for="parroquia">Parroquia:</label> 
            <input type="text" id="parroquia" name="parroquia" required value="Calderon" pattern="[A-Za-zÁÉÍÓÚÑáéíóúñ ]+" title="Solo letras y espacios"> 
          </div> 
          <div class="form-group"> 
            <label for="canton">Cantón:</label> 
            <input type="text" id="canton" name="canton" required value="Quito" pattern="[A-Za-zÁÉÍÓÚÑáéíóúñ ]+" title="Solo letras y espacios"> 
          </div> 
          <div class="form-group"> 
            <label for="ciudad">Ciudad:</label> 
            <input type="text" id="ciudad" name="ciudad" required value="Quito" pattern="[A-Za-zÁÉÍÓÚÑáéíóúñ ]+" title="Solo letras y espacios"> 
          </div> 
          <div class="form-group"> 
            <label for="provincia">Provincia:</label> 
            <input type="text" id="provincia" name="provincia" required value="Pichincha" pattern="[A-Za-zÁÉÍÓÚÑáéíóúñ ]+" title="Solo letras y espacios"> 
          </div> 
          <button type="submit" class="btn">Guardar</button> 
          <a href="/clientes" class="btn secondary">Cancelar</a> 
        </form> 
      </div> 
    </main> 
  </div> 
  <script> 
    document.querySelector('form').addEventListener('submit', function(event) { 
      let isValid = true; 

      // Validación de Nombre 
      const nombre = document.getElementById('nombre'); 
      if (!/^[A-Za-zÁÉÍÓÚáéíóúñÑ ]+$/.test(nombre.value)) { 
        alert('El nombre solo puede contener letras y espacios'); 
        isValid = false; 
      } 

      // Validación de Apellido 
      const apellido = document.getElementById('apellido'); 
      if (!/^[A-Za-zÁÉÍÓÚáéíóúñÑ ]+$/.test(apellido.value)) { 
        alert('El apellido solo puede contener letras y espacios'); 
        isValid = false; 
      } 

      // Validación de Cédula 
      const cedula = document.getElementById('cedula'); 
      if (!/^[0-9]{10}$/.test(cedula.value)) { 
        alert('La cédula debe tener exactamente 10 dígitos numéricos'); 
        isValid = false; 
      } 

      // Teléfono principal 
      const telefono1 = document.getElementById('telefono1'); 
      if (!/^[0-9]{10}$/.test(telefono1.value)) { 
        alert('El teléfono principal debe tener 10 dígitos numéricos'); 
        isValid = false; 
      } 

      // Teléfono secundario (opcional) 
      const telefono2 = document.getElementById('telefono2'); 
      if (telefono2.value && !/^[0-9]{10}$/.test(telefono2.value)) { 
        alert('El teléfono secundario debe tener 10 dígitos numéricos'); 
        isValid = false; 
      } 

      // Correo 
      const correo = document.getElementById('correo'); 
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(correo.value)) { 
        alert('Por favor ingrese un correo válido'); 
        isValid = false; 
      } 

      // Dirección 
      const direccion = document.getElementById('direccion'); 
      if (direccion.value.trim() === '') { 
        alert('La dirección no puede estar vacía'); 
        isValid = false; 
      } 

      // Parroquia 
      const parroquia = document.getElementById('parroquia'); 
      if (!/^[A-Za-zÁÉÍÓÚáéíóúñÑ ]+$/.test(parroquia.value)) { 
        alert('La parroquia solo puede contener letras y espacios'); 
        isValid = false; 
      } 

      // Cantón 
      const canton = document.getElementById('canton'); 
      if (!/^[A-Za-zÁÉÍÓÚáéíóúñÑ ]+$/.test(canton.value)) { 
        alert('El cantón solo puede contener letras y espacios'); 
        isValid = false; 
      } 

      // Ciudad 
      const ciudad = document.getElementById('ciudad'); 
      if (!/^[A-Za-zÁÉÍÓÚáéíóúñÑ ]+$/.test(ciudad.value)) { 
        alert('La ciudad solo puede contener letras y espacios'); 
        isValid = false; 
      } 

      // Provincia 
      const provincia = document.getElementById('provincia'); 
      if (!/^[A-Za-zÁÉÍÓÚáéíóúñÑ ]+$/.test(provincia.value)) { 
        alert('La provincia solo puede contener letras y espacios'); 
        isValid = false; 
      } 

      if (!isValid) { 
        event.preventDefault(); 
      } 
    }); 

    // ==== Validación en tiempo real ==== 
    const soloLetras = (id) => { 
      document.getElementById(id).addEventListener('input', function(e) { 
        this.value = this.value.replace(/[^A-Za-zÁÉÍÓÚáéíóúñÑ ]/g, ''); 
      }); 
    }; 

    soloLetras('nombre'); 
    soloLetras('apellido'); 
    soloLetras('parroquia'); 
    soloLetras('canton'); 
    soloLetras('ciudad'); 
    soloLetras('provincia'); 

    document.getElementById('cedula').addEventListener('input', function(e) { 
      this.value = this.value.replace(/[^0-9]/g, ''); 
    }); 

    document.getElementById('telefono1').addEventListener('input', function(e) { 
      this.value = this.value.replace(/[^0-9]/g, ''); 
    }); 

    document.getElementById('telefono2').addEventListener('input', function(e) { 
      this.value = this.value.replace(/[^0-9]/g, ''); 
    }); 
  </script> 
</body> 
</html>
