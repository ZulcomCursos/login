<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/login/auth.css">
</head>
<body class="auth-page">
  <div class="auth-container">
    <div class="auth-card">
      <div class="auth-header">
        <h2>Registro - Datos Personales</h2>
        <p>Complete los datos personales del nuevo colaborador</p>
      </div>
      <div class="auth-body">
        <% if (errors && Array.isArray(errors) && errors.length > 0) { %>
          <div class="auth-error">
            <ul>
              <% errors.forEach(error => { %>
                <li><%= error %></li>
              <% }); %>
            </ul>
          </div>
        <% } %>
        <form action="/auth/register-step1" method="POST" class="auth-form" id="registerForm">
          <div class="form-group">
            <label for="nombres">Nombres</label>
            <input type="text" id="nombres" name="nombres" pattern="[A-Za-zÁÉÍÓÚáéíóúñÑ ]+" title="Solo letras y espacios" value="<%= typeof formData !== 'undefined' ? formData.nombres : '' %>" required>
            <small class="error-message" id="nombres-error"></small>
          </div>
          <div class="form-group">
            <label for="apellidos">Apellidos</label>
            <input type="text" id="apellidos" name="apellidos" pattern="[A-Za-zÁÉÍÓÚáéíóúñÑ ]+" title="Solo letras y espacios" value="<%= typeof formData !== 'undefined' ? formData.apellidos : '' %>" required>
            <small class="error-message" id="apellidos-error"></small>
          </div>
           <div class="form-group">
            <label for="cedula">Cédula:</label>
            <input type="text" id="cedula" name="cedula" maxlength="10" required> <!-- MAximo 10-->
            <span class="error-message" id="cedula-error"></span>
          </div>
          
          <div class="form-group">
            <label for="telefono">Teléfono:</label>
            <input type="text" id="telefono" name="telefono" maxlength="10" required> <!-- MAximo 10-->
            <span class="error-message" id="telefono-error"></span>
          </div>
          <div class="form-group">
            <label for="domicilio">Domicilio</label>
            <input type="text" id="domicilio" name="domicilio" value="<%= typeof formData !== 'undefined' ? formData.domicilio : '' %>" required>
            <small class="error-message" id="domicilio-error"></small>
          </div>
          <div class="form-group">
            <label for="email">Correo Electrónico</label>
            <input type="email" id="email" name="email" value="<%= typeof formData !== 'undefined' ? formData.email : '' %>" required>
            <small class="error-message" id="email-error"></small>
          </div>
          <div class="form-group">
            <label for="role">Rol</label>
            <select id="role" name="role" required>
              <option value="">Seleccione un rol</option>
              <option value="Tecnico" <%= (typeof formData !== 'undefined' && formData.role === 'Tecnico') ? 'selected' : '' %>>Técnico</option>
              <option value="Administracion" <%= (typeof formData !== 'undefined' && formData.role === 'Administracion') ? 'selected' : '' %>>Administración</option>
              <option value="Gerente" <%= (typeof formData !== 'undefined' && formData.role === 'Gerente') ? 'selected' : '' %>>Gerente</option>
              <option value="User" <%= (typeof formData !== 'undefined' && formData.role === 'User') ? 'selected' : '' %>>Usuario Normal</option>
            </select>
          </div>
          <button type="submit" class="auth-button">Continuar</button>
        </form>
        <div class="auth-footer">
          <a href="/dashboard">Volver al dashboard</a>
        </div>
      </div>
    </div>
  </div>

  <script>
    document.getElementById('registerForm').addEventListener('submit', function(event) {
      let isValid = true;
      
      // Validación de Nombres (solo letras y espacios)
      const nombres = document.getElementById('nombres');
      const nombresError = document.getElementById('nombres-error');
      if (!/^[A-Za-zÁÉÍÓÚáéíóúñÑ ]+$/.test(nombres.value)) {
        nombresError.textContent = 'Solo se permiten letras y espacios';
        isValid = false;
      } else {
        nombresError.textContent = '';
      }
      
      // Validación de Apellidos (solo letras y espacios)
      const apellidos = document.getElementById('apellidos');
      const apellidosError = document.getElementById('apellidos-error');
      if (!/^[A-Za-zÁÉÍÓÚáéíóúñÑ ]+$/.test(apellidos.value)) {
        apellidosError.textContent = 'Solo se permiten letras y espacios';
        isValid = false;
      } else {
        apellidosError.textContent = '';
      }
      
      // Validación de Cédula (solo números, 6-10 dígitos)
      const cedula = document.getElementById('cedula');
      const cedulaError = document.getElementById('cedula-error');
      if (!/^[0-9]{9,10}$/.test(cedula.value)) {
        cedulaError.textContent = 'La cédula debe tener 10 dígitos numéricos';
        isValid = false;
      } else {
        cedulaError.textContent = '';
      }
      
      // Validación de Teléfono (solo números, 7-15 dígitos)
      const telefono = document.getElementById('telefono');
      const telefonoError = document.getElementById('telefono-error');
      if (!/^[0-9]{5,10}$/.test(telefono.value)) {
        telefonoError.textContent = 'El teléfono debe tener entre 5 y 10 dígitos numéricos';
        isValid = false;
      } else {
        telefonoError.textContent = '';
      }
      
      // Validación de Email
      const email = document.getElementById('email');
      const emailError = document.getElementById('email-error');
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value)) {
        emailError.textContent = 'Por favor ingrese un correo electrónico válido';
        isValid = false;
      } else {
        emailError.textContent = '';
      }
      
      // Validación de Domicilio (no vacío)
      const domicilio = document.getElementById('domicilio');
      const domicilioError = document.getElementById('domicilio-error');
      if (domicilio.value.trim() === '') {
        domicilioError.textContent = 'El domicilio no puede estar vacío';
        isValid = false;
      } else {
        domicilioError.textContent = '';
      }
      
      if (!isValid) {
        event.preventDefault();
      }
    });

    // Validación en tiempo real para campos de texto
    document.getElementById('nombres').addEventListener('input', function(e) {
      this.value = this.value.replace(/[^A-Za-zÁÉÍÓÚáéíóúñÑ ]/g, '');
    });

    document.getElementById('apellidos').addEventListener('input', function(e) {
      this.value = this.value.replace(/[^A-Za-zÁÉÍÓÚáéíóúñÑ ]/g, '');
    });

    document.getElementById('cedula').addEventListener('input', function(e) {
      this.value = this.value.replace(/[^0-9]/g, '');
    });

    document.getElementById('telefono').addEventListener('input', function(e) {
      this.value = this.value.replace(/[^0-9]/g, '');
    });
  </script>
</body>
</html>